# ── Core ──────────────────────────────────────────────────────────────────────
SESSION_SECRET=replace-with-random-64-byte-secret
NODE_ENV=development
PORT=8787
ALLOWED_ORIGIN=http://localhost:3000

# ── Chain ─────────────────────────────────────────────────────────────────────
CHAIN_ID=8453
RPC_URL=https://mainnet.base.org
USAGE_CONTRACT=0xYourUsageContract
SPAT_TOKEN=0x7f18bdbe376b3b0648ad75da2fcc52f8c107bcdf

# ── Agent wallet (owns treasury, signs messages, sends/receives payments) ─────
# Generate with: node -e "const {ethers}=require('ethers'); const w=ethers.Wallet.createRandom(); console.log(w.privateKey, w.address)"
AGENT_PRIVATE_KEY=0xYourAgentWalletPrivateKey

# ── OpenRouter LLM Provider ───────────────────────────────────────────────────
OPENROUTER_API_KEY=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
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# ── x402 micropayments ────────────────────────────────────────────────────────
# Optional: external facilitator for payment verification (Coinbase x402, etc.)
X402_FACILITATOR_URL=

# ── MCP server ────────────────────────────────────────────────────────────────
MCP_PORT=8788

# ── A2A (Agent-to-Agent) ──────────────────────────────────────────────────────
# JSON array of peer agents: [{"name":"PeerBot","url":"https://peer.example.com"}]
A2A_AGENT_REGISTRY=[]

# ── Optional integrations ─────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379
REQUEST_TIMEOUT_MS=20000
WORKFLOW_DEFAULT_WEBHOOK=
SERVICE_MAP_JSON={"notifier":{"url":"https://example.com/notify","method":"POST"}}
